# Copy this file to ".env" and fill in whichever keys you have.
# The system works even with ZERO keys filled in (mock-LLM offline mode),
# but real reasoning text requires at least one key below.

# Used for: Data Scout Agent, Topic Modeling Agent (light/fast tier)
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# Used for: Advisory Agent's ReAct reasoning (heavy tier) — preferred
ANTHROPIC_API_KEY=

# Used for: Advisory Agent's ReAct reasoning (heavy tier) — fallback if no Anthropic key
OPENAI_API_KEY=

# Optional model overrides
GROQ_MODEL=llama-3.1-8b-instant
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
OPENAI_MODEL=gpt-4o-mini
